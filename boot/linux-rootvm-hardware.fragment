# Diosix Native Root VM Hardware Driver Fragment
# Enables host physical device drivers (PCIe, Storage, USB, Network, Display)

# Core Bus & PCIe
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_RISCV_HOST=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_ECAM=y

# Storage & Block Devices
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_VIRTIO_BLK=y

# Filesystems for Host Storage
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y

# USB Subsystem & Host Controllers
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y

# Networking & Packet Routing
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y

# Graphics & Display
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y

# Input & Console
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HVC_RISCV_SBI=y
