# Diosix Native Root VM Hardware Driver Fragment
# Dedicated exclusively to RISC-V 64-bit host hardware.
# Disables ARM, x86_64, ACPI, EFI, and non-generic vendor SoC legacy code.

# Core Architecture & Pure RV64 target
CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_RISCV=y
CONFIG_ARCH_VIRT=y
# CONFIG_COMPAT is not set
# CONFIG_ARCH_ANDES is not set
# CONFIG_ARCH_ANLOGIC is not set
# CONFIG_ARCH_MICROCHIP_POLARFIRE is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPACEMIT is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_TENSTORRENT is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_CANAAN is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_SOC_SIFIVE is not set
# CONFIG_SOC_SUNXI is not set
# CONFIG_SOC_THEAD is not set
# CONFIG_SOC_CANAAN is not set
# CONFIG_SOC_MICROCHIP_POLARFIRE is not set

# Disable non-RISC-V firmware & platform features
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_HPET is not set
# CONFIG_VGA_ARB is not set

# Core Bus & PCIe
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_RISCV_HOST=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_ECAM=y

# Storage & Block Devices
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y

# Filesystems for Host Storage
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y

# USB Subsystem & Host Controllers
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
# CONFIG_USB_HID is not set
# CONFIG_INPUT is not set
# CONFIG_HID is not set
# CONFIG_THERMAL is not set

# Networking & Packet Routing
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y

# Sound & Audio (Disabled - Headless Root VM)
# CONFIG_SOUND is not set
# CONFIG_SND is not set

# Graphics, Framebuffers & Displays (Disabled - Headless Root VM)
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_LOGO is not set

# Mice, Touchscreens & Joysticks (Disabled)
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TOUCHSCREEN is not set

# Media, Webcams & Capture (Disabled)
# CONFIG_MEDIA_SUPPORT is not set

# Wireless & Bluetooth (Disabled)
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set

# Serial & Hypervisor Consoles
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HVC_RISCV_SBI=y

# Virtual Sockets (AF_VSOCK) & VirtIO-vsock Transport
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
CONFIG_VIRTIO_MMIO=y

