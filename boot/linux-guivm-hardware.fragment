# Diosix GUI Domain (sys.gui) Hardware Driver Fragment
# Dedicated to display virtualization, physical DRM/KMS, and user seat input.

# Core Architecture & Pure RV64 target
CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_RISCV=y
CONFIG_ARCH_VIRT=y

# Core Bus & PCIe
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_ECAM=y

# Direct Rendering Manager (DRM) & KMS
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_FB=y
CONFIG_FB_DEFERRED_IO=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Input & Seat Devices (evdev & VirtIO)
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# Storage & Memory
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y

# Networking & Virtual Sockets (Waypipe transport)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# Serial & Consoles
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HVC_RISCV_SBI=y
