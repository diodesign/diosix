# Enable EXPERT to allow stripping core subsystems
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y

# Networking & UNIX Domain Sockets
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y

# Disable unused subsystems
# CONFIG_PCI is not set
# CONFIG_USB is not set

# CONFIG_SOUND is not set
# CONFIG_THERMAL is not set
# CONFIG_VGA_ARB is not set
# CONFIG_DRM is not set
# CONFIG_BT is not set
# CONFIG_WIRELESS is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_NFC is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_HPET is not set
# CONFIG_ACPI is not set
# CONFIG_VT is not set
# CONFIG_VT_CONSOLE is not set
# CONFIG_HW_CONSOLE is not set
# CONFIG_HUGETLB_PAGE is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_SECURITY is not set
# CONFIG_SECURITYFS is not set
# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_EFI is not set
# CONFIG_CGROUPS is not set
# CONFIG_SWAP is not set


# Disable Block & SCSI storage stack
# CONFIG_BLOCK is not set
# CONFIG_SCSI_MOD is not set
# CONFIG_SCSI is not set
# CONFIG_SCSI_VIRTIO is not set
# CONFIG_ATA is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_SCSI is not set

# Disable unused storage & bus peripherals
# CONFIG_MMC is not set
# CONFIG_SPI is not set
# CONFIG_I2C is not set
# CONFIG_MTD is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_HID is not set
# CONFIG_WATCHDOG is not set
# CONFIG_HWMON is not set
# CONFIG_POWER_SUPPLY is not set
# CONFIG_POWER_RESET is not set
# CONFIG_REGULATOR is not set
# CONFIG_RESET_CONTROLLER is not set
# CONFIG_PM_DEVFREQ is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_EXTCON is not set
# CONFIG_PWM is not set
# CONFIG_MAILBOX is not set
# CONFIG_BLK_DEV_BSG is not set

# Disable vendor SoC platform architectures (keep only ARCH_VIRT)
# CONFIG_ARCH_ANDES is not set
# CONFIG_ARCH_ANLOGIC is not set
# CONFIG_ARCH_MICROCHIP_POLARFIRE is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPACEMIT is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_TENSTORRENT is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_CANAAN is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_SOC_SIFIVE is not set
# CONFIG_SOC_SUNXI is not set
# CONFIG_SOC_THEAD is not set
# CONFIG_SOC_CANAAN is not set
# CONFIG_SOC_MICROCHIP_POLARFIRE is not set
CONFIG_ARCH_VIRT=y

# Disable DMA engine and unused virtio drivers
# CONFIG_DMADEVICES is not set
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_INPUT is not set


# Disable unused disk filesystems (rootfs is pure in-memory initramfs)
# CONFIG_EXT4_FS is not set
# CONFIG_JBD2 is not set
# CONFIG_FAT_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_AUTOFS4_FS is not set
# CONFIG_NLS is not set

# Disable input, keyboard, mouse, and serio subsystems
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_KEYBOARD_GPIO is not set
# CONFIG_MOUSE_PS2 is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_EVDEV is not set

# Disable unused GPIO and power reset drivers
# CONFIG_GPIOLIB is not set
# CONFIG_GPIO_DWAPB is not set
# CONFIG_GPIO_SIFIVE is not set
# CONFIG_POWER_RESET_GPIO_RESTART is not set
# CONFIG_POWER_RESET_SYSCON is not set
# CONFIG_POWER_RESET_SYSCON_POWEROFF is not set

# Disable PMU and profiling overhead
# CONFIG_PERF_EVENTS is not set
# CONFIG_RISCV_PMU_SBI is not set
# CONFIG_RISCV_PMU_LEGACY is not set
# CONFIG_IO_URING is not set
# CONFIG_AIO is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_SERIAL_SIFIVE is not set
# CONFIG_SERIAL_8250_DW is not set

# Disable tracing, BPF and debug overhead
# CONFIG_FTRACE is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_DEBUG_FS is not set

# Uncompressed rootfs / initramfs for high-performance guest execution
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_INITRAMFS_COMPRESSION_GZIP is not set
# CONFIG_INITRAMFS_COMPRESSION_BZIP2 is not set
# CONFIG_INITRAMFS_COMPRESSION_LZMA is not set
# CONFIG_INITRAMFS_COMPRESSION_XZ is not set
# CONFIG_INITRAMFS_COMPRESSION_LZO is not set
# CONFIG_INITRAMFS_COMPRESSION_LZ4 is not set
# CONFIG_INITRAMFS_COMPRESSION_ZSTD is not set


