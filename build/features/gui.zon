.{
    .{
        .id = "gui-desktop-core",
        .name = "Desktop compositor core and semantic JSON IPC",
        .layer = .u_mode_gui,
        .status = .active,
        .files = .{
            "tools/diosix-gui/src/main.zig",
            "tools/diosix-gui/src/paths.zig",
            "tools/diosix-gui/src/demo.zig",
            "tools/diosix-gui/src/gui.zig",
            "tools/diosix-gui/src/gui/chrome.zig",
            "tools/diosix-gui/src/gui/input.zig",
            "tools/diosix-gui/src/gui/nav.zig",
            "tools/diosix-gui/src/gui/render.zig",
            "tools/diosix-gui/src/gui/json.zig",
            "tools/diosix-gui/src/ipc.zig",
            "tools/diosix-gui/src/window.zig",
            "tools/diosix-gui/src/window/input.zig",
            "tools/diosix-gui/src/icon.zig",
            "tools/diosix-gui/src/icon/render.zig",
            "tools/diosix-gui/src/icon/text.zig",
            "tools/diosix-gui/src/icon/widgets.zig",
            "tools/diosix-gui/src/label.zig",
        },
        .summary =
        \\Root VM desktop event loop, window and widget tree, animated
        \\top-left menu navigation, dirty-rectangle compositor, and semantic
        \\JSON state export and command IPC.
        ,
        .activated_by = .{
            "rootvm-init-overlay",
        },
        .docs = .{
            "docs/gui-architecture.md#desktop-layout-and-workflows",
            "docs/gui-architecture.md#semantic-json-control-plane",
            "docs/run.md#exploring-the-interactive-tour-and-desktop",
        },
    },
