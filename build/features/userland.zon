        .summary =
        \\Manages Diosix Personal desktop VM profiles, exclusive MMIO and IRQ
        \\passthrough binding, host platform driver unbinding, and desktop
        \\VM switching.
        ,
        .activated_by = .{
            "cli-core-dispatch",
            "cli-vm-lifecycle",
            "rootvm-init-overlay",
        },
        .docs = .{
            "docs/cli.md#dsx-personal",
            "docs/editions.md#direct-hardware-access-and-desktop-workloads",
