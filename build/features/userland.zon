        ,
        .activated_by = .{
            "cli-core-dispatch",
            "cli-net-ssh",
            "cli-governance-auth-charter",
        },
        .docs = .{
            "docs/cli.md#dsx-agent",
            "docs/security.md#autonomous-node-agents-and-mission-consensus",
        },
    },
    .{
        .id = "cli-multihost-swarm",
        .name = "Multi-host Ed25519 swarm fleet mesh (`dsx swarm`)",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/swarm.zig",
            "tools/diosix-ctl/src/swarm/protocol.zig",
            "tools/diosix-ctl/src/swarm/server.zig",
        },
        .summary =
        \\Host-to-host TCP peer collaboration using Ed25519 node identities,
        \\fleet-wide Mission dissemination, stake vote aggregation,
        \\deterministic replica sharding, and firewall denial of child VMs.
        ,
        .activated_by = .{
            "cli-core-dispatch",
            "cli-net-ssh",
            "cli-governance-auth-charter",
        },
        .docs = .{
            "docs/cli.md#dsx-swarm",
            "docs/architecture.md#multi-host-fleet-collaboration",
        },
    },
    .{
        .id = "cli-personal-desktop",
        .name = "Personal desktop profile and passthrough CLI (`dsx personal`)",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/personal.zig",
            "tools/diosix-ctl/src/personal/config.zig",
            "tools/diosix-ctl/src/personal/launch.zig",
