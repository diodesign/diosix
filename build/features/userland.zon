.{
    .{
        .id = "rootvm-init-overlay",
        .name = "Root VM init scripts, edition overlays, and runtime config",
        .layer = .rootvm_init,
        .status = .active,
        .files = .{
            "tools/overlay-common/etc/diosix/catalog.toml",
            "tools/overlay-common/etc/diosix/diosix.toml",
            "tools/overlay-common/etc/diosix/edition",
            "tools/overlay-common/etc/diosix/install.toml",
            "tools/overlay-common/etc/diosix/keys/.gitkeep",
            "tools/overlay-common/etc/diosix/system.toml",
            "tools/overlay-common/etc/group",
            "tools/overlay-common/etc/init.d/S50diosix",
            "tools/overlay-common/etc/init.d/S50dropbear",
            "tools/overlay-common/etc/iptables.conf",
            "tools/overlay-common/etc/issue",
            "tools/overlay-common/etc/motd",
            "tools/overlay-common/etc/passwd",
            "tools/overlay-common/etc/profile",
            "tools/overlay-common/usr/sbin/diosix-stage-storage",
            "tools/overlay-swarm/etc/diosix/agent.toml",
            "tools/overlay-swarm/etc/diosix/charter.toml",
            "tools/overlay-swarm/etc/diosix/constitution.md",
            "tools/overlay-swarm/etc/diosix/edition",
            "tools/overlay-swarm/usr/sbin/diosix-agent-start",
            "tools/overlay-personal/etc/diosix/edition",
            "tools/overlay-personal/etc/diosix/personal.toml",
            "tools/overlay-cli/etc/diosix/guest-profile",
            "tools/overlay-cli/etc/motd",
        },
        .summary =
        \\Root VM and child guest BusyBox init scripts, composable edition
        \\overlays (core, swarm, personal), boot-mode storage mounting,
        \\key-only SSH daemon config, firewall NAT rules, and TOML manifests.
        ,
        .activated_by = .{
            "mmode-rootvm-boot",
            "buildroot-packaging",
        },
        .docs = .{
            "docs/run.md#how-boot-modes-work",
            "docs/editions.md#ssh-first-interaction-model",
            "docs/editions.md#comparing-diosix-editions",
            "docs/editions.md#direct-hardware-access-and-desktop-workloads",
            "docs/security.md#direct-device-passthrough-and-dma-security",
            "docs/cli.md#runtime-configuration-files-and-permissions",
            "docs/security.md#ssh-passkeys-and-downward-management",
        },
    },
    .{
        .id = "libdiosix-userland-sdk",
        .name = "Userland C and Zig hypervisor control library (libdiosix)",
        .layer = .u_mode_sdk,
        .status = .active,
        .files = .{
            "tools/libdiosix/include/diosix.h",
            "tools/libdiosix/src/lib.zig",
            "tools/libdiosix/src/governance.zig",
            "tools/libdiosix/src/passthrough.zig",
            "tools/libdiosix/src/c_abi.zig",
            "tools/libdiosix/src/c_abi_passthrough.zig",
            "tools/libdiosix/examples/vm_info.c",
        },
        .summary =
        \\Reusable Zig client and C99 ABI library (libdiosix.a / libdiosix.so)
        \\wrapping /dev/diosix ioctls for guest lifecycle, memory, console,
        \\networking, and governance calls.
        ,
        .activated_by = .{
            "build-zig-pipeline",
            "rootvm-kernel-driver",
        },
        .docs = .{
            "docs/interface.md#userland-c-and-zig-library-libdiosix",
        },
    },
    .{
        .id = "cli-core-dispatch",
        .name = "CLI command router, hypervisor client, and guest registry",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/main.zig",
            "tools/diosix-ctl/src/api.zig",
            "tools/diosix-ctl/src/common.zig",
            "tools/diosix-ctl/src/common/output.zig",
            "tools/diosix-ctl/src/sysconfig.zig",
            "tools/diosix-ctl/src/sysconfig/parser.zig",
            "tools/diosix-ctl/src/registry.zig",
        },
        .summary =
        \\Top-level CLI command dispatcher, libdiosix client re-export
        \\wrapper, runtime configuration loader, JSON and text output
        \\helpers, and active guest registry.
        ,
        .activated_by = .{
            "rootvm-init-overlay",
            "libdiosix-userland-sdk",
        },
        .docs = .{
            "docs/cli.md#context-id-syntax",
            "docs/cli.md#command-reference",
        },
    },
    .{
        .id = "cli-host-install",
        .name = "Host management, telemetry, and disk installer commands",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/host.zig",
            "tools/diosix-ctl/src/host/info.zig",
            "tools/diosix-ctl/src/installer.zig",
            "tools/diosix-ctl/src/installer/apply.zig",
        },
        .summary =
        \\Host inspection, SSH-first workflows, GPT target-disk installer,
        \\and host reboot and poweroff commands.
        ,
        .activated_by = .{
            "cli-core-dispatch",
        },
        .docs = .{
            "docs/cli.md#dsx-host",
            "docs/run.md#managing-hosts-and-guests-over-ssh",
            "docs/run.md#provisioning-a-target-disk",
        },
    },
    .{
        .id = "cli-vm-lifecycle",
        .name = "VM launch, guest installer, console, and quota commands",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/vm.zig",
            "tools/diosix-ctl/src/vm/run.zig",
            "tools/diosix-ctl/src/vm/run/policy.zig",
            "tools/diosix-ctl/src/vm/run_opts.zig",
            "tools/diosix-ctl/src/vm/stage.zig",
            "tools/diosix-ctl/src/vm/bootargs.zig",
            "tools/diosix-ctl/src/vm/fdt_guest.zig",
            "tools/diosix-ctl/src/vm/fdt_patch.zig",
            "tools/diosix-ctl/src/vm/info.zig",
            "tools/diosix-ctl/src/vm/install.zig",
            "tools/diosix-ctl/src/vm/restart.zig",
            "tools/diosix-ctl/src/vm/console.zig",
            "tools/diosix-ctl/src/vm/quota.zig",
            "tools/diosix-ctl/src/vm/owned.zig",
            "tools/diosix-ctl/src/vm/passthrough.zig",
            "tools/diosix-ctl/src/console.zig",
            "tools/diosix-ctl/src/loader.zig",
            "tools/diosix-ctl/src/loader/pe.zig",
        },
        .summary =
        \\Child VM staging and launch, ELF, flat kernel, and PE32+ EFI
        \\loader, child DTB patching, VM status and listing, serial console
        \\attachment, stop, restart, quota updates, and hardware-trust drop.
        ,
        .activated_by = .{
            "cli-core-dispatch",
        },
        .docs = .{
            "docs/cli.md#dsx-run",
            "docs/cli.md#dsx-info",
            "docs/cli.md#dsx-list",
            "docs/cli.md#dsx-console",
            "docs/cli.md#dsx-stop",
            "docs/cli.md#dsx-restart",
            "docs/cli.md#dsx-quota",
            "docs/cli.md#dsx-install-guest",
            "docs/cli.md#dsx-drop-trust",
            "docs/guests.md#built-in-risc-v-guest-images",
            "docs/guests.md#booting-an-iso9660-image",
        },
    },
    .{
        .id = "cli-net-ssh",
        .name = "Guest network routing policies and SSH login commands",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/net.zig",
            "tools/diosix-ctl/src/net/firewall.zig",
            "tools/diosix-ctl/src/net/http.zig",
            "tools/diosix-ctl/src/net/http/peer.zig",
            "tools/diosix-ctl/src/ssh.zig",
            "tools/diosix-ctl/src/ssh/sync.zig",
        },
        .summary =
        \\Per-VM network isolation and router-VM chaining, firewall NAT and
        \\forwarding rule synchronization, and downward Ed25519 SSH shell
        \\and command execution.
        ,
        .activated_by = .{
            "cli-core-dispatch",
            "cli-vm-lifecycle",
        },
        .docs = .{
            "docs/cli.md#dsx-net",
            "docs/cli.md#dsx-ssh",
            "docs/security.md#network-security-and-service-vm-routing",
        },
    },
    .{
        .id = "cli-storage-images-snapshots",
        .name = "Virtual disk, catalog image, and RAM checkpoint commands",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/storage.zig",
            "tools/diosix-ctl/src/storage/disk.zig",
            "tools/diosix-ctl/src/storage/seed.zig",
            "tools/diosix-ctl/src/image.zig",
            "tools/diosix-ctl/src/image/pull.zig",
            "tools/diosix-ctl/src/image/import.zig",
            "tools/diosix-ctl/src/catalog.zig",
            "tools/diosix-ctl/src/catalog/format.zig",
            "tools/diosix-ctl/src/snapshot.zig",
            "tools/diosix-ctl/src/snapshot/memory.zig",
        },
        .summary =
        \\Virtual disk creation and NoCloud seeding, SHA-256-verified
        \\catalog and ISO management, and live 64 MiB child RAM
        \\checkpointing.
        ,
        .activated_by = .{
            "cli-core-dispatch",
            "cli-vm-lifecycle",
        },
        .docs = .{
            "docs/cli.md#dsx-disk",
            "docs/cli.md#dsx-image",
            "docs/cli.md#dsx-snapshot",
            "docs/guests.md#seeding-and-booting-disk-images",
            "docs/guests.md#saving-and-restoring-ram-checkpoints",
        },
    },
    .{
        .id = "cli-governance-auth-charter",
        .name = "Passkey enrollment, manifest pruning, and charter commands",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/governance.zig",
            "tools/diosix-ctl/src/auth.zig",
            "tools/diosix-ctl/src/auth/enroll.zig",
            "tools/diosix-ctl/src/auth/hardware.zig",
            "tools/diosix-ctl/src/passkey.zig",
            "tools/diosix-ctl/src/manifest.zig",
            "tools/diosix-ctl/src/manifest/cmd.zig",
            "tools/diosix-ctl/src/manifest/lexer.zig",
            "tools/diosix-ctl/src/manifest/policy.zig",
            "tools/diosix-ctl/src/charter.zig",
            "tools/diosix-ctl/src/charter/amend.zig",
            "tools/diosix-ctl/src/charter/cmd.zig",
            "tools/diosix-ctl/src/charter/crypto.zig",
            "tools/diosix-ctl/src/charter/ops.zig",
            "tools/diosix-ctl/src/charter/sign.zig",
            "tools/diosix-ctl/src/charter/status.zig",
            "tools/diosix-ctl/src/charter/toml.zig",
            "tools/diosix-ctl/src/charter/whisper.zig",
            "tools/diosix-ctl/src/whisper.zig",
        },
        .summary =
        \\Passkey and TPM 2.0 or FIDO2 hardware-seeded key enrollment,
        \\capability manifest pruning and service lookup, and charter
        \\sealing, steward voting, whisper frames, resets, and failover.
        ,
        .activated_by = .{
            "cli-core-dispatch",
            "cli-vm-lifecycle",
        },
        .docs = .{
            "docs/cli.md#dsx-auth",
            "docs/cli.md#dsx-manifest",
            "docs/cli.md#dsx-charter",
            "docs/security.md#declarative-manifests-and-charter-governance",
        },
    },
    .{
        .id = "cli-pkg-proxy",
        .name = "Recursive attenuating Alpine APK proxy (`dsx pkg`)",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/pkg.zig",
            "tools/diosix-ctl/src/pkg/index.zig",
            "tools/diosix-ctl/src/pkg/policy.zig",
            "tools/diosix-ctl/src/pkg/server.zig",
        },
        .summary =
        \\Parent-hosted Alpine APK proxy enforcing monotonic allow and deny
        \\ceilings, transitive dependency closure evaluation, and recursive
        \\upstream package fetching from parent VMs or signed local seeds.
        ,
        .activated_by = .{
            "cli-core-dispatch",
            "cli-net-ssh",
        },
        .docs = .{
            "docs/cli.md#dsx-pkg",
            "docs/security.md#hierarchical-package-attenuation",
        },
    },
    .{
        .id = "cli-message-board",
        .name = "Parent-moderated anti-collusion message board (`dsx board`)",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/board.zig",
            "tools/diosix-ctl/src/board/server.zig",
            "tools/diosix-ctl/src/board/store.zig",
            "tools/diosix-ctl/src/board/store/policy.zig",
        },
        .summary =
        \\Append-only SHA-256 hash-chained message board hosted by each
        \\parent VM with MAC-authenticated child identity, visibility
        \\filtering, and hard rejection of lateral child-to-child messages.
        ,
        .activated_by = .{
            "cli-core-dispatch",
            "cli-net-ssh",
        },
        .docs = .{
            "docs/cli.md#dsx-board",
            "docs/security.md#anti-collusion-parent-message-boards",
        },
    },
    .{
        .id = "cli-autonomous-agent",
        .name = "Autonomous node agent and parent LLM proxy (`dsx agent`)",
        .layer = .u_mode_cli,
        .status = .active,
        .files = .{
            "tools/diosix-ctl/src/agent.zig",
            "tools/diosix-ctl/src/agent/admin.zig",
            "tools/diosix-ctl/src/agent/admin/quota.zig",
            "tools/diosix-ctl/src/agent/autonomy.zig",
            "tools/diosix-ctl/src/agent/autonomy/actions.zig",
            "tools/diosix-ctl/src/agent/autonomy/telemetry.zig",
            "tools/diosix-ctl/src/agent/config.zig",
            "tools/diosix-ctl/src/agent/config/parser.zig",
            "tools/diosix-ctl/src/agent/gateway.zig",
            "tools/diosix-ctl/src/agent/gateway/backend.zig",
            "tools/diosix-ctl/src/agent/ledger.zig",
            "tools/diosix-ctl/src/agent/ledger/store.zig",
