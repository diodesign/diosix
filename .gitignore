# Zig compiler cache and build output directories.
.zig-cache/
zig-out/

# Standalone compiled binaries, raw dumps, disk/ISO images, and temp files.
*.elf
*.bin
*.iso
*.img
*.tmp*

# Keep pre-rendered GUI font and cloud-map assets embedded via @embedFile.
!tools/diosix-gui/src/*.bin
!tools/diosix-gui/src/**/*.bin

# Never commit private SSH or passkey material into the static rootfs overlay.
tools/overlay-common/etc/diosix/keys/*
!tools/overlay-common/etc/diosix/keys/.gitkeep

# Local QEMU, build, and test debug logs.
*.log

# Local developer custom agent configurations.
.agents
