#!/bin/sh
#
# S70weston-desktop: Start seatd, Weston Wayland compositor, and terminal.
#
# Copyright (c) 2026 Chris Williams <chrisw@diosix.org>
# SPDX-License-Identifier: MIT

XDG_DIR="/run/user/0"
SEATD_SOCK_PATH="/run/seatd.sock"
WESTON_LOG="/var/log/weston.log"

start_desktop() {
    # Skip Weston if Diosix GUI owns the framebuffer or was requested.
    if pidof diosix-gui >/dev/null 2>&1 || \
       grep -qw "diosix.wm=diosix-gui" /proc/cmdline 2>/dev/null; then
        return 0
    fi

    WAIT_DRI=0
    while [ ! -c /dev/dri/card0 ] && [ "$WAIT_DRI" -lt 25 ]; do
        sleep 0.2
        WAIT_DRI=$((WAIT_DRI + 1))
    done
    if [ ! -c /dev/dri/card0 ]; then
        echo "Weston desktop: No /dev/dri/card0 VirtIO-GPU scanout; skipping."
        return 0
    fi

    if command -v udevadm >/dev/null 2>&1; then
        udevadm trigger --type=subsystems --action=add 2>/dev/null || true
        udevadm trigger --type=devices --action=add 2>/dev/null || true
        udevadm settle --timeout=5 2>/dev/null || true
    fi

    mkdir -p "$XDG_DIR" /var/log
    chmod 0700 "$XDG_DIR"

    if ! pidof seatd >/dev/null 2>&1; then
        seatd -u root -g root -l silent > /var/log/seatd.log 2>&1 &
    fi
    WAIT_SEAT=0
    while [ ! -S "$SEATD_SOCK_PATH" ] && [ "$WAIT_SEAT" -lt 25 ]; do
        sleep 0.1
        WAIT_SEAT=$((WAIT_SEAT + 1))
    done

    if pidof weston >/dev/null 2>&1; then
        echo "Weston Wayland desktop is already running."
        return 0
    fi

    echo "Starting Weston Wayland desktop on /dev/dri/card0..."
    export HOME="/root"
    export USER="root"
    export LOGNAME="root"
    export SHELL="/bin/bash"
    export LANG="en_US.UTF-8"
    export XDG_RUNTIME_DIR="$XDG_DIR"
    export SEATD_SOCK="$SEATD_SOCK_PATH"
    export LIBSEAT_BACKEND="seatd"

    weston -B drm --use-pixman --config=/root/.config/weston.ini \
        --log="$WESTON_LOG" > /var/log/weston-stdout.log 2>&1 &

    # Automatically open an interactive Wayland terminal window once ready.
    (
        TRIES=0
        while [ "$TRIES" -lt 75 ]; do
            for sock in "$XDG_DIR"/wayland-*; do
                if [ -S "$sock" ]; then
                    WAYLAND_DISPLAY="$(basename "$sock")" \
                    XDG_RUNTIME_DIR="$XDG_DIR" \
                    HOME="/root" \
                    SHELL="/bin/bash" \
                    /usr/bin/weston-terminal \
                        > /var/log/weston-terminal.log 2>&1 &
                    exit 0
                fi
            done
            sleep 0.2
            TRIES=$((TRIES + 1))
        done
    ) &
}

stop_desktop() {
    echo "Stopping Weston Wayland desktop..."
    pkill -x weston-terminal 2>/dev/null || true
    pkill -x weston 2>/dev/null || true
}

case "$1" in
  start)
    start_desktop
    ;;
  stop)
    stop_desktop
    ;;
  restart)
    stop_desktop
    sleep 1
    start_desktop
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
