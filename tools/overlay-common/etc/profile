# System-wide profile for Diosix Root VM and guest domains.
export PATH="/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin"
export PS1='# '
export TERM=xterm-256color

# Enable readline window size updates on commands when running under GNU Bash.
if [ -n "$BASH_VERSION" ]; then
    shopt -s checkwinsize 2>/dev/null || true
fi

# Apply wide terminal boundary if virtual serial console does not negotiate dimensions.
if [ -t 0 ] && command -v stty >/dev/null 2>&1; then
    stty cols 120 rows 35 2>/dev/null || true
fi
