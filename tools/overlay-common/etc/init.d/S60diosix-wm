#!/bin/sh
#
# S60diosix-wm: Launch Diosix GUI if graphical display device is present.
#
# Copyright (c) 2026 Chris Williams <chrisw@diosix.org>
# SPDX-License-Identifier: MIT

case "$1" in
  start)
    GUI_BIN="/usr/bin/diosix-gui"

    if pidof diosix-gui >/dev/null 2>&1; then
        echo "Diosix GUI is already running."
        exit 0
    fi

    if [ -x "$GUI_BIN" ] && [ -c /dev/dri/card0 -o -c /dev/fb0 ]; then
        [ -x /usr/sbin/diosix-alsa-init ] && /usr/sbin/diosix-alsa-init
        echo "Starting Diosix GUI ($GUI_BIN)..."
        "$GUI_BIN" > /var/log/diosix-gui.log 2>&1 &
    else
        echo "Diosix GUI: Headless display mode (console login active)."
    fi
    ;;
  stop)
    echo "Stopping Diosix GUI..."
    pkill -x diosix-gui 2>/dev/null || true
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
