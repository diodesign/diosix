#!/bin/sh
#
# S60diosix-wm: Launch Diosix Window Manager if graphical display device is present
#

case "$1" in
  start)
    GUI_BIN=""
    if [ -x /usr/bin/diosix-gui ]; then
        GUI_BIN="/usr/bin/diosix-gui"
    elif [ -x /usr/bin/diosix-wm ]; then
        GUI_BIN="/usr/bin/diosix-wm"
    fi

    if [ -n "$GUI_BIN" ] && [ -c /dev/dri/card0 -o -c /dev/fb0 ]; then
        echo "Starting Diosix GUI ($GUI_BIN)..."
        $GUI_BIN > /var/log/diosix-gui.log 2>&1 &
    else
        echo "Diosix GUI: Headless/non-framebuffer display mode (console login active)."
    fi
    ;;
  stop)
    echo "Stopping Diosix GUI..."
    pkill -x diosix-gui 2>/dev/null || pkill -x diosix-wm 2>/dev/null || true
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
