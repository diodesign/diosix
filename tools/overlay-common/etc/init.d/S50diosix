#!/bin/sh
#
# S50diosix: Diosix guest initialization and management service.
#
# Copyright (c) 2026 Chris Williams <chrisw@diosix.org>
# SPDX-License-Identifier: MIT

STATE_DIR="/var/lib/diosix"
ETC_DIR="/etc/diosix"
RUN_DIR="/run/diosix"
SHARE_IMAGES_DIR="/usr/share/diosix/images"
KEY_DIR="${STATE_DIR}/keys"
MGT_KEY="${KEY_DIR}/id_management"
PASSKEYS="${KEY_DIR}/authorized_passkeys"
DEV_KEYS="${KEY_DIR}/dev_authorized_keys"
AUTH_KEYS="/root/.ssh/authorized_keys"
CHILD_SUBNET="10.0.3.0/24"
CHILD_GW="10.0.3.1"
WAN_FALLBACK_IP="10.0.2.15"
WAN_FALLBACK_CIDR="10.0.2.15/24"
WAN_FALLBACK_GW="10.0.2.2"
WAN_FALLBACK_DNS="10.0.2.3"

case "$1" in
  start)
    echo "Starting Diosix guest services..."
    # Ensure /dev/diosix device node exists if needed.
    KMOD="/lib/modules/$(uname -r)/extra/diosix.ko"
    if [ ! -c /dev/diosix ] && [ -f "$KMOD" ]; then
        modprobe diosix 2>/dev/null || insmod "$KMOD" 2>/dev/null || true
    fi
    # Set up runtime directories and SSH key permissions.
    mkdir -p /run/dropbear /var/run/dropbear /etc/dropbear \
        "$RUN_DIR" /var/run/diosix "$ETC_DIR/keys" /root/.ssh
    chmod 700 /run/dropbear /var/run/dropbear /etc/dropbear \
        /root/.ssh "$ETC_DIR/keys" 2>/dev/null || true

    # Identify VM Context ID (CID).
    SELF_CID=1
    DSX_BIN=""
    for candidate in /usr/sbin/dsx /usr/bin/dsx /usr/sbin/diosix-ctl; do
        if [ -x "$candidate" ]; then
            DSX_BIN="$candidate"
            break
        fi
    done
    if [ -n "$DSX_BIN" ]; then
        CID_VAL=$("$DSX_BIN" info 2>/dev/null | \
            grep -i "^Assigned CID" | awk '{print $NF}')
        if [ -n "$CID_VAL" ]; then
            SELF_CID=$CID_VAL
        fi
    fi

    # Initialize /root/.ssh/authorized_keys with strict permissions.
    touch "$AUTH_KEYS" 2>/dev/null || true
    chmod 600 "$AUTH_KEYS" 2>/dev/null || true

    # Set up standard loopback networking.
    ifconfig lo 127.0.0.1 up 2>/dev/null || true

    # Bring up diosix0 virtual network interface with 10.0.3.<cid>.
    if ip link show diosix0 >/dev/null 2>&1; then
        ip addr flush dev diosix0 2>/dev/null || true
        ip addr add "10.0.3.${SELF_CID}/24" dev diosix0 2>/dev/null || \
            ifconfig diosix0 "10.0.3.${SELF_CID}" \
                netmask 255.255.255.0 up 2>/dev/null || true
        ip link set diosix0 up 2>/dev/null || true
        ip route add "$CHILD_SUBNET" dev diosix0 2>/dev/null || true
    fi

    # Network routing and gateway configuration.
    if [ "$SELF_CID" = "1" ]; then
        echo "Diosix root VM (trusted host supervisor)" \
            > /etc/issue 2>/dev/null || true
        # Root VM: Configure physical/virtual WAN uplink.
        WAN_IF=""
        for iface in /sys/class/net/eth* /sys/class/net/en* \
            /sys/class/net/wlan*; do
            if [ -d "$iface" ]; then
                iname=$(basename "$iface")
                if [ "$iname" != "diosix0" ] && [ "$iname" != "lo" ] && \
                   [ "$iname" != "sit0" ] && [ "$iname" != "*" ]; then
                    WAN_IF="$iname"
                    break
                fi
            fi
        done

        if [ -n "$WAN_IF" ]; then
            ip link set "$WAN_IF" up 2>/dev/null || \
                ifconfig "$WAN_IF" up 2>/dev/null || true
            # Try DHCP via udhcpc in non-blocking mode with fast timeout.
            if [ -x /sbin/udhcpc ] || [ -x /usr/sbin/udhcpc ]; then
                udhcpc -i "$WAN_IF" -t 2 -T 1 -b -q \
                    -p "/var/run/udhcpc.${WAN_IF}.pid" >/dev/null 2>&1 || true
            fi
            # Set static IP fallback for QEMU user network (10.0.2.15/24).
            if ! ip -4 addr show dev "$WAN_IF" 2>/dev/null | \
               grep -q "inet "; then
                ip addr add "$WAN_FALLBACK_CIDR" dev "$WAN_IF" 2>/dev/null || \
                    ifconfig "$WAN_IF" "$WAN_FALLBACK_IP" \
                        netmask 255.255.255.0 up 2>/dev/null || true
                ip route add default via "$WAN_FALLBACK_GW" \
                    dev "$WAN_IF" 2>/dev/null || \
                    route add default gw "$WAN_FALLBACK_GW" \
                        "$WAN_IF" 2>/dev/null || true
            fi
        fi

        # DNS configuration.
        printf "nameserver 1.1.1.1\nnameserver 8.8.8.8\nnameserver %s\n" \
            "$WAN_FALLBACK_DNS" > /etc/resolv.conf

        # Enable IPv4 packet forwarding and NAT masquerade for child domains.
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        if command -v iptables-restore >/dev/null 2>&1 && \
           [ -f /etc/iptables.conf ]; then
            iptables-restore < /etc/iptables.conf 2>/dev/null || true
        fi
        if command -v iptables >/dev/null 2>&1; then
            # 1. Outbound NAT masquerade from child subnet to WAN.
            iptables -t nat -C POSTROUTING -s "$CHILD_SUBNET" \
                ! -d "$CHILD_SUBNET" -j MASQUERADE 2>/dev/null || \
            iptables -t nat -A POSTROUTING -s "$CHILD_SUBNET" \
                ! -d "$CHILD_SUBNET" -j MASQUERADE 2>/dev/null || true

            # 2. Allow Wayland translation bridge (port 8484) from child VMs.
            iptables -C INPUT -i diosix0 -p tcp --dport 8484 \
                -m conntrack --ctstate NEW -j ACCEPT 2>/dev/null || \
            iptables -A INPUT -i diosix0 -p tcp --dport 8484 \
                -m conntrack --ctstate NEW -j ACCEPT 2>/dev/null || true

            # 3. Block all other new incoming connections from child VMs.
            iptables -C INPUT -i diosix0 -m conntrack --ctstate NEW \
                -j DROP 2>/dev/null || \
            iptables -A INPUT -i diosix0 -m conntrack --ctstate NEW \
                -j DROP 2>/dev/null || true
            iptables -C INPUT -s "$CHILD_SUBNET" -m conntrack --ctstate NEW \
                -j DROP 2>/dev/null || \
            iptables -A INPUT -s "$CHILD_SUBNET" -m conntrack --ctstate NEW \
                -j DROP 2>/dev/null || true

            # 4. Block lateral traffic between sibling child VMs.
            iptables -C FORWARD -s "$CHILD_SUBNET" -d "$CHILD_SUBNET" \
                -j DROP 2>/dev/null || \
            iptables -A FORWARD -s "$CHILD_SUBNET" -d "$CHILD_SUBNET" \
                -j DROP 2>/dev/null || true

            # 5. Allow outbound WAN traffic and stateful return responses.
            iptables -C FORWARD -s "$CHILD_SUBNET" -j ACCEPT 2>/dev/null || \
            iptables -A FORWARD -s "$CHILD_SUBNET" -j ACCEPT 2>/dev/null || true
            iptables -C FORWARD -d "$CHILD_SUBNET" -m state \
                --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
            iptables -A FORWARD -d "$CHILD_SUBNET" -m state \
                --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
        fi
    else
        echo "Diosix guest VM (CID ${SELF_CID})" \
            > /etc/issue 2>/dev/null || true
        # Child VM: Route through parent VM (10.0.3.1).
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        ip route add default via "$CHILD_GW" dev diosix0 2>/dev/null || \
            route add default gw "$CHILD_GW" diosix0 2>/dev/null || true
        # Configure DNS fallback.
        if [ ! -s /etc/resolv.conf ] || \
           grep -q "127.0.0.1" /etc/resolv.conf 2>/dev/null; then
            {
                echo "nameserver 1.1.1.1"
                echo "nameserver 8.8.8.8"
                echo "nameserver ${CHILD_GW}"
            } > /etc/resolv.conf
        fi
    fi

    # Automount host storage disk at /var/lib/diosix.
    mkdir -p "$STATE_DIR" "$ETC_DIR"
    for dev in /dev/vda2 /dev/vda1 /dev/vda /dev/sda2 /dev/sda1 /dev/sda \
        /dev/nvme0n1p2 /dev/nvme0n1p1 /dev/nvme0n1 \
        /dev/mmcblk0p2 /dev/mmcblk0p1 /dev/mmcblk0; do
        if [ -b "$dev" ]; then
            if mount -o rw "$dev" "$STATE_DIR" 2>/dev/null || \
               mount "$dev" "$STATE_DIR" 2>/dev/null; then
                echo "Mounted persistent storage $dev on $STATE_DIR."
                SYS_TOML="${STATE_DIR}/manifests/system.toml"
                if [ -f "$SYS_TOML" ] && [ ! -f "${ETC_DIR}/system.toml" ]; then
                    ln -sf "$SYS_TOML" "${ETC_DIR}/system.toml" \
                        2>/dev/null || true
                fi
                break
            fi
        fi
    done

    mkdir -p "${STATE_DIR}/images" "${STATE_DIR}/iso"
    if [ -f "${SHARE_IMAGES_DIR}/micro-guest.elf" ] && \
       [ ! -e "${STATE_DIR}/images/micro-guest.elf" ]; then
        ln -sf "${SHARE_IMAGES_DIR}/micro-guest.elf" \
            "${STATE_DIR}/images/micro-guest.elf" 2>/dev/null || true
    fi
    if [ -f "${SHARE_IMAGES_DIR}/micro-guest.iso" ] && \
       [ ! -e "${STATE_DIR}/iso/micro-guest.iso" ]; then
        ln -sf "${SHARE_IMAGES_DIR}/micro-guest.iso" \
            "${STATE_DIR}/iso/micro-guest.iso" 2>/dev/null || true
    fi
    GUEST_ELF="${STATE_DIR}/images/linux-guest.elf"
    if [ -f "$GUEST_ELF" ]; then
        ln -sf "$GUEST_ELF" \
            "${STATE_DIR}/images/default.elf" 2>/dev/null || true
    fi

    # Configure Zero-Password Passkey & Parent-to-Child Management Keys.
    mkdir -p "$KEY_DIR" "${ETC_DIR}/keys" "$RUN_DIR"
    chmod 700 "$KEY_DIR" "${ETC_DIR}/keys" 2>/dev/null || true

    if [ ! -f "$MGT_KEY" ] && command -v dropbearkey >/dev/null 2>&1; then
        dropbearkey -t ed25519 -f "$MGT_KEY" >/dev/null 2>&1 || true
        chmod 600 "$MGT_KEY" 2>/dev/null || true
    fi
    if [ -f "$MGT_KEY" ]; then
        if [ ! -s "${MGT_KEY}.pub" ] && \
           command -v dropbearkey >/dev/null 2>&1; then
            dropbearkey -y -f "$MGT_KEY" 2>/dev/null | \
                grep "^ssh-" > "${MGT_KEY}.pub" || true
            chmod 644 "${MGT_KEY}.pub" 2>/dev/null || true
        fi
        ln -sf "$MGT_KEY" "${ETC_DIR}/keys/id_management" 2>/dev/null || true
        if [ -s "${MGT_KEY}.pub" ]; then
            ln -sf "${MGT_KEY}.pub" \
                "${ETC_DIR}/keys/id_management.pub" 2>/dev/null || true
        fi
    fi

    if [ "$SELF_CID" -eq 1 ]; then
        touch "$PASSKEYS" 2>/dev/null || true
        chmod 600 "$PASSKEYS" 2>/dev/null || true

        # In diosix.mode=dev, auto-enroll injected developer keys.
        if grep -q "diosix.mode=dev" /proc/cmdline 2>/dev/null; then
            if [ -s "$DEV_KEYS" ]; then
                cat "$DEV_KEYS" >> "$PASSKEYS" 2>/dev/null || true
            fi
            if [ -s "${MGT_KEY}.pub" ]; then
                cat "${MGT_KEY}.pub" >> "$PASSKEYS" 2>/dev/null || true
            fi
            sort -u "$PASSKEYS" -o "$PASSKEYS" 2>/dev/null || true
        fi

        if [ -s "$PASSKEYS" ]; then
            cat "$PASSKEYS" >> "$AUTH_KEYS" 2>/dev/null || true
        fi
    else
        # Child VM: Extract parent management public key staged in manifest.
        if [ -n "$DSX_BIN" ]; then
            "$DSX_BIN" manifest show --cid 1 --hv 2>/dev/null | \
                sed -n 's/^# diosix-authorized-key: //p' \
                >> "$AUTH_KEYS" 2>/dev/null || true
        fi
        if [ -s "$PASSKEYS" ]; then
            cat "$PASSKEYS" >> "$AUTH_KEYS" 2>/dev/null || true
        fi
    fi

    sort -u "$AUTH_KEYS" -o "$AUTH_KEYS" 2>/dev/null || true
    chmod 600 "$AUTH_KEYS" 2>/dev/null || true
    echo "Diosix guest services: OK"
    ;;
  stop)
    echo "Stopping Diosix guest services..."
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit 0
