#!/bin/sh
#
# S50diosix: Diosix guest initialization and management service
#

case "$1" in
  start)
    echo "Starting Diosix guest services..."
    # Ensure /dev/diosix device node exists if needed
    if [ ! -c /dev/diosix ] && [ -f /lib/modules/$(uname -r)/extra/diosix.ko ]; then
        modprobe diosix 2>/dev/null || insmod /lib/modules/$(uname -r)/extra/diosix.ko 2>/dev/null || true
    fi
    # Set up runtime directories and SSH key permissions
    mkdir -p /run/dropbear /var/run/dropbear /etc/dropbear /var/run/diosix /etc/diosix/keys /root/.ssh
    chmod 700 /run/dropbear /var/run/dropbear /etc/dropbear /root/.ssh /etc/diosix/keys 2>/dev/null || true

    # Generate internal Dropbear client key if not present and authorize it
    if [ ! -f /etc/diosix/keys/id_dropbear ] && [ -x /usr/bin/dropbearkey ]; then
        /usr/bin/dropbearkey -t ed25519 -f /etc/diosix/keys/id_dropbear >/dev/null 2>&1 || true
        /usr/bin/dropbearkey -y -f /etc/diosix/keys/id_dropbear 2>/dev/null | grep "^ssh-ed25519" >> /root/.ssh/authorized_keys 2>/dev/null || true
    fi

    chmod 600 /root/.ssh/authorized_keys /etc/diosix/keys/id_dropbear /etc/diosix/keys/id_ed25519 2>/dev/null || true

    # Set up standard loopback networking
    ifconfig lo 127.0.0.1 up 2>/dev/null || true

    # Set up dedicated virtual VM network device (diosix0) for 10.0.3.0/24 subnet
    SELF_CID=1
    DSX_BIN=""
    for bin_path in /usr/sbin/dsx /sbin/dsx /usr/bin/dsx /bin/dsx; do
        if [ -x "$bin_path" ]; then
            DSX_BIN="$bin_path"
            break
        fi
    done
    if [ -n "$DSX_BIN" ]; then
        CID_VAL=$("$DSX_BIN" info 2>/dev/null | grep -i "^Context ID" | awk '{print $NF}')
        if [ -n "$CID_VAL" ]; then
            SELF_CID=$CID_VAL
        fi
    fi

    # Bring up diosix0 virtual network interface with 10.0.3.<cid>
    if ip link show diosix0 >/dev/null 2>&1; then
        ip addr flush dev diosix0 2>/dev/null || true
        ip addr add 10.0.3.${SELF_CID}/24 dev diosix0 2>/dev/null || ifconfig diosix0 10.0.3.${SELF_CID} netmask 255.255.255.0 up 2>/dev/null || true
        ip link set diosix0 up 2>/dev/null || true
        ip route add 10.0.3.0/24 dev diosix0 2>/dev/null || true
    fi

    # Network routing and gateway configuration
    if [ "$SELF_CID" = "1" ]; then
        # Root VM (Domain 0): Enable IPv4 packet forwarding and NAT masquerade for child guests
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        if command -v iptables >/dev/null 2>&1; then
            iptables -t nat -C POSTROUTING -s 10.0.3.0/24 ! -d 10.0.3.0/24 -j MASQUERADE 2>/dev/null || \
            iptables -t nat -A POSTROUTING -s 10.0.3.0/24 ! -d 10.0.3.0/24 -j MASQUERADE 2>/dev/null || true
            iptables -C FORWARD -s 10.0.3.0/24 -j ACCEPT 2>/dev/null || \
            iptables -A FORWARD -s 10.0.3.0/24 -j ACCEPT 2>/dev/null || true
            iptables -C FORWARD -d 10.0.3.0/24 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
            iptables -A FORWARD -d 10.0.3.0/24 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
        fi
    else
        # Child VM: Set default route via Root VM (10.0.3.1)
        ip route add default via 10.0.3.1 dev diosix0 2>/dev/null || route add default gw 10.0.3.1 diosix0 2>/dev/null || true
        # Configure DNS fallback if resolv.conf is empty or unconfigured
        if [ ! -s /etc/resolv.conf ] || grep -q "127.0.0.1" /etc/resolv.conf 2>/dev/null; then
            printf "nameserver 1.1.1.1\nnameserver 8.8.8.8\n" > /etc/resolv.conf
        fi
    fi

    # Automount host storage disk at /var/lib/diosix (e.g. GPT partition 2 /dev/vda2, /dev/sda2, /dev/nvme0n1p2, /dev/mmcblk0p2)
    mkdir -p /var/lib/diosix /boot /etc/diosix
    for dev in /dev/vda2 /dev/vda1 /dev/vda /dev/sda2 /dev/sda1 /dev/sda /dev/nvme0n1p2 /dev/nvme0n1p1 /dev/nvme0n1 /dev/mmcblk0p2 /dev/mmcblk0p1 /dev/mmcblk0; do
        if [ -b "$dev" ]; then
            if mount -o rw "$dev" /var/lib/diosix 2>/dev/null || mount "$dev" /var/lib/diosix 2>/dev/null; then
                echo "Mounted persistent storage volume $dev on /var/lib/diosix."
                if [ -f /var/lib/diosix/manifests/system.toml ] && [ ! -f /etc/diosix/system.toml ]; then
                    ln -sf /var/lib/diosix/manifests/system.toml /etc/diosix/system.toml 2>/dev/null || true
                fi
                if [ -f /var/lib/diosix/images/linux-guest.elf ]; then
                    ln -sf /var/lib/diosix/images/linux-guest.elf /boot/linux-guest.elf 2>/dev/null || true
                    ln -sf /var/lib/diosix/images/linux-guest.elf /boot/default.elf 2>/dev/null || true
                    ln -sf /var/lib/diosix/images/linux-guest.elf /boot/vmlinux.elf 2>/dev/null || true
                elif [ -f /var/lib/diosix/images/vmlinux.elf ]; then
                    ln -sf /var/lib/diosix/images/vmlinux.elf /boot/vmlinux.elf 2>/dev/null || true
                fi
                break
            fi
        fi
    done
    ;;
  stop)
    echo "Stopping Diosix guest services..."
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
esac

exit 0
