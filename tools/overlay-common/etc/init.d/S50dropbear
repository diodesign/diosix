#!/bin/sh
#
# Starts dropbear sshd for Diosix guests and Root VM.
#
# Copyright (c) 2026 Chris Williams <chrisw@diosix.org>
# SPDX-License-Identifier: MIT

export PATH="/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin"

find_bin() {
    name="$1"
    for dir in /usr/sbin /usr/bin /sbin /bin /usr/local/sbin /usr/local/bin
    do
        if [ -x "${dir}/${name}" ]; then
            printf '%s\n' "${dir}/${name}"
            return 0
        fi
    done
    command -v "$name" 2>/dev/null || return 1
}

start() {
    printf "Starting dropbear sshd: "
    mkdir -p /run/dropbear /var/run/dropbear /etc/dropbear /root/.ssh
    chmod 700 /run/dropbear /var/run/dropbear /etc/dropbear \
        /root/.ssh 2>/dev/null || true

    DROPBEAR_BIN="$(find_bin dropbear || true)"
    DROPBEARKEY_BIN="$(find_bin dropbearkey || true)"
    if [ -z "$DROPBEAR_BIN" ]; then
        echo "SKIP (missing binary)"
        return 0
    fi

    HOST_KEY="/etc/dropbear/dropbear_ed25519_host_key"
    PERSIST_KEY="/var/lib/diosix/keys/dropbear_ed25519_host_key"
    if [ -s "$PERSIST_KEY" ] && [ ! -s "$HOST_KEY" ]; then
        cp "$PERSIST_KEY" "$HOST_KEY" 2>/dev/null || true
        chmod 600 "$HOST_KEY" 2>/dev/null || true
    fi
    if [ ! -s "$HOST_KEY" ] && [ -n "$DROPBEARKEY_BIN" ]; then
        "$DROPBEARKEY_BIN" -t ed25519 -f "$HOST_KEY" >/dev/null 2>&1 || true
        chmod 600 "$HOST_KEY" 2>/dev/null || true
    fi
    if [ -s "$HOST_KEY" ] && [ -d /var/lib/diosix/keys ] && \
       [ ! -s "$PERSIST_KEY" ]; then
        cp "$HOST_KEY" "$PERSIST_KEY" 2>/dev/null || true
        chmod 600 "$PERSIST_KEY" 2>/dev/null || true
    fi
    if [ -s "$HOST_KEY" ] && [ -n "$DROPBEARKEY_BIN" ]; then
        HOST_PUB=$("$DROPBEARKEY_BIN" -y -f "$HOST_KEY" 2>/dev/null | \
            grep "^ssh-" | awk '{print $1 " " $2}')
        if [ -n "$HOST_PUB" ]; then
            echo "$HOST_PUB" > "${HOST_KEY}.pub" 2>/dev/null || true
            chmod 644 "${HOST_KEY}.pub" 2>/dev/null || true
            KNOWN_HOSTS="/root/.ssh/known_hosts"
            touch "$KNOWN_HOSTS" 2>/dev/null || true
            grep -vE '^(127\.0\.0\.1|localhost) ' "$KNOWN_HOSTS" \
                > "${KNOWN_HOSTS}.tmp" 2>/dev/null || true
            printf "127.0.0.1 %s\nlocalhost %s\n" "$HOST_PUB" "$HOST_PUB" \
                >> "${KNOWN_HOSTS}.tmp" 2>/dev/null || true
            mv -f "${KNOWN_HOSTS}.tmp" "$KNOWN_HOSTS" 2>/dev/null || true
            chmod 600 "$KNOWN_HOSTS" 2>/dev/null || true
        fi
    fi

    if [ -r /var/run/dropbear.pid ] && \
       kill -0 "$(cat /var/run/dropbear.pid 2>/dev/null)" 2>/dev/null; then
        echo "OK"
        return 0
    fi

    "$DROPBEAR_BIN" -P /var/run/dropbear.pid -r "$HOST_KEY" -s -g -p 22
    [ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
    printf "Stopping dropbear sshd: "
    if [ -s /var/run/dropbear.pid ]; then
        kill "$(cat /var/run/dropbear.pid)" 2>/dev/null || true
        rm -f /var/run/dropbear.pid
    fi
    killall dropbear 2>/dev/null || true
    echo "OK"
}

restart() {
    stop
    start
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart|reload)
    restart
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit 0
